# Copied to backend/.env by scripts/setup.sh, which fills in APP_SECRET_KEY.
# Never commit backend/.env.

# PostgreSQL 16 on this computer (Homebrew's default: your Mac user, no password).
DATABASE_URL=postgresql+psycopg://localhost:5432/ai_image_studio

# Root key for encrypting provider API keys. 64 hex characters (openssl rand -hex 32).
# Changing it makes saved API keys unreadable: they must then be entered again.
APP_SECRET_KEY=

# Where generated images are stored (relative to backend/ or absolute).
# STORAGE_DIR=storage

# The studio opens without a sign-in screen and uses the first account on this Mac.
# Set to false to require signing in with email and password again.
# AUTO_LOGIN=false
